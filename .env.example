# PostgreSQL is the production database. Leave DATABASE_URL empty to use SQLite offline.
DATABASE_URL=
FARMMATCH_DB=backend/farmmatch.db
FARMMATCH_MODE=demo
FARMMATCH_SEED_DEMO=true
DEMO_INVENTORY_MULTIPLIER=2.0
AUTH_REQUIRED=false
AUTH_COOKIE_NAME=farmmatch_session
AUTH_COOKIE_SECURE=false
AUTH_SESSION_HOURS=8
AUTH_BOOTSTRAP_USERNAME=admin
AUTH_BOOTSTRAP_PASSWORD=
AUTH_MAX_LOGIN_ATTEMPTS=5
AUTH_LOGIN_WINDOW_MINUTES=15
AUTH_LOCKOUT_MINUTES=15
INTEGRATION_API_KEY=
AGENT_RUNTIME=agentarts
DEMO_PACING_FACTOR=0
AGENTARTS_ENABLED=false
AGENTARTS_BASE_URL=
AGENTARTS_API_KEY=
AGENTARTS_INVOKE_PATH=/invocations
AGENTARTS_AGENT_ENDPOINTS_JSON={}
AGENTARTS_AGENT_KEYS_JSON={}
AGENTARTS_AUTH_HEADER=Authorization
AGENTARTS_AUTH_PREFIX=Bearer 
AGENTARTS_SESSION_HEADER=x-hw-agentarts-session-id
AGENTARTS_TIMEOUT=20

# Outbound tool/MCP safety. Add only trusted public domains to the allowlist.
TOOL_ALLOWED_HOSTS=example.com
TOOL_ALLOW_PRIVATE_HOSTS=false
TOOL_HTTP_TIMEOUT=20
MCP_PROTOCOL_VERSION=2024-11-05
# Optional JSON override for task-type to capability tags
AGENT_TASK_CAPABILITY_MAP_JSON=
A2A_ENABLED=true
RUN_WORKER_CONCURRENCY=2
RUN_QUEUE_MAX_SIZE=100
RUN_LEASE_SECONDS=120
RUN_POLL_INTERVAL_SECONDS=0.25
RETRY_WORKER_ENABLED=true
RETRY_MAX_ATTEMPTS=3
RETRY_POLL_INTERVAL_SECONDS=5
RESERVATION_TTL_HOURS=24
RESERVATION_SWEEP_INTERVAL_SECONDS=60
RESERVATION_SWEEP_ENABLED=true
EVALUATION_SOAK_SECONDS=30
EVALUATION_CONCURRENCY_LEVELS=1,5,10,20

# Optional true embedding backend. hash works offline; remote uses /embeddings.
EMBEDDING_PROVIDER=hash
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=256
EMBEDDING_TIMEOUT=20
EMBEDDING_BATCH_SIZE=64
# Optional local semantic embedding; install backend/requirements-vector.txt first.
LOCAL_EMBEDDING_ENABLED=false
LOCAL_EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# DeepSeek / OpenAI-compatible LLM Planner
# Replace sk-xxx with a real key. Placeholder keys are treated as disabled.
LLM_ENABLED=true
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-xxx
LLM_MODEL=deepseek-chat
# Verify: curl -H "Authorization: Bearer sk-xxx" https://api.deepseek.com/v1/models
# Free-tier AMap Web Service key for address geocoding.
AMAP_WEB_SERVICE_KEY=

# Free public OSRM demo endpoint; replace with a self-hosted OSRM URL in production.
OSRM_BASE_URL=https://router.project-osrm.org
OSRM_TIMEOUT=20
